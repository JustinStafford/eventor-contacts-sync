# Copy to .env for local runs. Never commit .env.

# Required
EVENTOR_API_KEY=
GOOGLE_USER=president@yourdomain.example
GOOGLE_SERVICE_ACCOUNT=eventor-contacts-sync@your-project.iam.gserviceaccount.com

# Alternative to keyless auth: a service-account key file (only if your organisation
# allows key creation). When set, GOOGLE_SERVICE_ACCOUNT is not needed.
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/key.json

# Optional (defaults shown)
# EVENTOR_BASE_URL=https://eventor.orienteering.asn.au/api
# EVENTOR_CACHE_DIR=.eventor-cache     # cache Eventor responses between dry runs
# EVENTOR_CACHE_TTL_SECONDS=3600
# SYNC_WINDOW_MONTHS=12
# SYNC_PREVIOUS_YEAR_UNTIL_MONTH=3
# SYNC_REQUIRE_PAID=true
# SYNC_LABEL_ALL=Eventor
# SYNC_LABEL_MEMBER=Member
# SYNC_LABEL_ENTRANT=Entrant
# SYNC_UPDATE_NAMES=true
# SYNC_ADDRESSES=true
# SYNC_ADOPT_EXISTING=true
# SYNC_MAX_REMOVAL_PERCENT=25
# SYNC_PHONE_COUNTRY_CODE=61
# SYNC_REPORT_PATH=report.json
